---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="topbar">
  <div class="topbar-start">
    <button class="icon-button menu-toggle" id="menuToggle" aria-label="باز کردن منو" aria-controls="sidebar">
      <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <div class="breadcrumb"><span>فضای کاری</span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg><strong id="breadcrumbCurrent">نمای کلی</strong></div>
  </div>
  <div class="topbar-end">
    <button class="search-box global-search" id="globalSearch" type="button" aria-label="جست‌وجوی سراسری (Control K)">
      <svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
      <input type="search" placeholder="جست‌وجوی مشتری، سند..." aria-hidden="true" tabindex="-1" />
      <kbd>Ctrl K</kbd>
    </button>
    <button class="icon-button theme-toggle" id="themeToggle" aria-label="تغییر پوسته روشن و تاریک" data-tooltip-host data-tooltip="تغییر تم">
      <svg class="theme-icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="theme-icon-moon" viewBox="0 0 24 24" style="display:none"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    </button>
    <div class="notifications-wrap">
      <button class="icon-button" id="notificationBtn" aria-label="اعلان‌ها" aria-expanded="false" aria-haspopup="true">
        <svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg>
        <i class="badge-dot" aria-hidden="true"></i>
      </button>
      <div class="notifications-panel" id="notificationsPanel" role="region" aria-label="مرکز اعلان‌ها">
        <div class="notifications-head"><span>اعلان‌ها</span><span class="demo-chip">نمایشی</span></div>
        <div class="notifications-list" id="notificationsList"></div>
        <div class="notifications-foot"><span class="table-note" style="margin:0">اعلان‌های نمونه؛ اتصال به سیستم واقعی ندارند.</span></div>
      </div>
    </div>
    <div class="topbar-divider" aria-hidden="true"></div>
    <div class="user-dropdown-wrap">
      <button class="user-menu" id="userMenuBtn" aria-expanded="false" aria-haspopup="true">
        <span class="user-avatar">م</span>
        <span class="user-details"><strong>مدیر سامانه</strong><small>دسترسی نمایشی</small></span>
        <svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg>
      </button>
      <div class="dropdown user-dropdown" id="userDropdown" role="menu">
        <div class="dropdown-head">حساب کاربری (نمایشی)</div>
        <button class="dropdown-item" role="menuitem" data-toast="حساب مدیر در نسخه عملیاتی متصل می‌شود."><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/></svg>پروفایل</button>
        <button class="dropdown-item" role="menuitem" data-toast="تنظیمات حساب در نسخه عملیاتی فعال می‌شود."><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="m19 15 .3 1.6 1.7.8-.3 1.9-1.9.5-1-1.4-1.8.2-1 1.6-1.9-.5-.2-1.9 1.4-1-0.3-1.8 1.7-.9L15 13l1.8-.5 1 1.4 1.9-.2Z"/></svg>تنظیمات حساب</button>
        <div class="dropdown-sep"></div>
        <button class="dropdown-item" role="menuitem" data-toast="ورود و خروج در نسخه نمایشی فعال نیست."><svg viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l-5-5 5-5M5 12h12"/></svg>خروج</button>
      </div>
    </div>
  </div>
</header>
