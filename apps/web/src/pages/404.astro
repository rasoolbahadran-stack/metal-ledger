---
import Layout from '../layouts.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="صفحه یافت نشد | فلزنگار" description="صفحه مورد نظر در فلزنگار پیدا نشد.">
  <div class="landing" style="min-height:100vh;display:grid;place-items:center">
    <main style="text-align:center;padding:24px" id="mainContent">
      <p style="color:var(--accent-strong);font-weight:800;font-size:clamp(52px,10vw,96px);line-height:1.2">۴۰۴</p>
      <h1 style="font-size:clamp(20px,3.4vw,30px);margin:8px 0 12px">این صفحه پیدا نشد</h1>
      <p style="color:var(--text-soft);max-width:420px;margin:0 auto 28px;line-height:2">
        آدرسی که باز کرده‌اید وجود ندارد یا جابه‌جا شده است. از لینک‌های زیر ادامه دهید.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="button button-primary" href={`${base}/`}>صفحه اصلی</a>
        <a class="button button-secondary" href={`${base}/app/`}>نسخه نمایشی پنل</a>
      </div>
    </main>
  </div>
</Layout>
