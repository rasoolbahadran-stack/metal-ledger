  <!-- Trade modal: client-side demo only -->
  <div class="modal-backdrop" id="tradeModal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="tradeModalTitle">
      <div class="modal-head"><div><span class="eyebrow"><span class="eyebrow-line"></span>سند آزمایشی</span><h2 id="tradeModalTitle">ثبت معامله جدید</h2></div><button class="icon-button modal-close" data-close-modal aria-label="بستن"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
      <form id="tradeForm" class="modal-form">
        <label>مشتری<select id="tradeCustomer" required><option value="">انتخاب مشتری</option><option>محمدرضا احمدی</option><option>سارا محمدی</option><option>علی رضایی</option><option>نگار کریمی</option></select></label>
        <div class="form-two"><label>نوع معامله<select id="tradeType" required><option value="buy">خرید مشتری از ما</option><option value="sell">فروش مشتری به ما</option></select></label><label>محصول<select id="tradeProduct"><option value="طلای ۱۸ عیار" data-price="7500000">طلای ۱۸ عیار</option><option value="نقره خالص" data-price="82000">نقره خالص</option><option value="پلاتین" data-price="3850000">پلاتین</option></select></label></div>
        <div class="form-two"><label>وزن (گرم)<input id="tradeWeight" type="number" min="0.001" step="0.001" placeholder="مثلاً ۲۵۰" required /></label><label>قیمت واحد (واحد پول نمونه)<input id="tradePrice" type="number" min="0" step="1" value="7500000" required /></label></div>
        <div class="amount-preview"><span>مبلغ محاسبه‌شده نمونه</span><strong id="tradeAmount">۰ واحد پول نمونه</strong></div>
        <label>توضیحات<textarea id="tradeNotes" rows="2" placeholder="توضیحات تکمیلی (اختیاری)"></textarea></label>
        <div class="modal-disclaimer">ثبت این فرم فقط ردیف نمایشی را در همین صفحه اضافه می‌کند؛ سند مالی واقعی ایجاد نمی‌شود.</div>
        <div class="modal-actions"><button type="button" class="button button-secondary" data-close-modal>انصراف</button><button type="submit" class="button button-primary">افزودن به نمایش</button></div>
      </form>
    </div>
  </div>

  <div class="modal-backdrop" id="customerModal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="customerModalTitle">
      <div class="modal-head"><div><span class="eyebrow"><span class="eyebrow-line"></span>مشتری آزمایشی</span><h2 id="customerModalTitle">افزودن مشتری</h2></div><button class="icon-button modal-close" data-close-modal aria-label="بستن"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
      <form id="customerForm" class="modal-form"><label>نام و نام خانوادگی<input id="newCustomerName" required placeholder="نام مشتری" /></label><label>شماره تماس<input id="newCustomerPhone" inputmode="tel" placeholder="شماره تماس" /></label><label>یادداشت<textarea id="newCustomerNotes" rows="2" placeholder="یادداشت داخلی (اختیاری)"></textarea></label><div class="modal-disclaimer">این مشتری فقط تا زمان بارگذاری مجدد صفحه در فهرست نمایشی باقی می‌ماند.</div><div class="modal-actions"><button type="button" class="button button-secondary" data-close-modal>انصراف</button><button type="submit" class="button button-primary">افزودن به نمایش</button></div></form>
    </div>
  </div>

  <div class="toast-region" id="toastRegion" aria-live="polite" aria-atomic="true"></div>
