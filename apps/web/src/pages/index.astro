---
import Layout from '../layouts.astro';
---

<Layout>
  <div class="app-shell" id="appShell">
    <aside class="sidebar" id="sidebar" aria-label="ناوبری اصلی">
      <div class="brand-row">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none"><path d="M8 26.5 15.8 11l4.3 8.1 4.2-8.1L32 26.5H8Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M12 29.5h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="20" cy="8" r="1.7" fill="currentColor"/></svg>
        </div>
        <div class="brand-copy"><strong>فلزنگار</strong><span>METAL LEDGER</span></div>
        <button class="icon-button sidebar-close" id="sidebarClose" aria-label="بستن منو"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
      </div>

      <div class="workspace-switcher">
        <div class="workspace-icon">م</div>
        <div class="workspace-copy"><span>فضای کاری</span><strong>بازرگانی میزان فلز</strong></div>
        <svg class="chevron" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg>
      </div>

      <div class="nav-caption">فضای کاری</div>
      <nav class="nav-list">
        <button class="nav-link active" data-view="dashboard"><svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="4.5" rx="1.5"/><rect x="13.5" y="11" width="7" height="9.5" rx="1.5"/><rect x="3.5" y="13" width="7" height="7.5" rx="1.5"/></svg><span>نمای کلی</span><kbd>۱</kbd></button>
        <button class="nav-link" data-view="customers"><svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM16 3.2a4 4 0 0 1 0 7.6M17 14.7a4 4 0 0 1 4 4V20"/></svg><span>مشتریان</span><span class="nav-count">۱۲۸</span></button>
        <button class="nav-link" data-view="trades"><svg viewBox="0 0 24 24"><path d="M4 7h15M15 3l4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg><span>معاملات</span></button>
        <button class="nav-link" data-view="balances"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 7h14M7 7l-4 7h8L7 7ZM17 7l-4 7h8l-4-7ZM8 21h8"/></svg><span>مانده وزنی</span></button>
      </nav>

      <div class="nav-caption nav-caption-gap">مدیریت عملیات</div>
      <nav class="nav-list">
        <button class="nav-link" data-view="prices"><svg viewBox="0 0 24 24"><path d="M4 18.5 9 13l3.5 3.5L20 8M15 8h5v5"/><path d="M4 4v16h16"/></svg><span>قیمت فلزات</span><i class="live-dot"></i></button>
        <button class="nav-link" data-view="products"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.8 7.5 4.4 7.5-4.4M12 12.2V21"/></svg><span>محصولات</span></button>
        <button class="nav-link" data-view="payments"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg><span>پرداخت‌ها</span></button>
        <button class="nav-link" data-view="deliveries"><svg viewBox="0 0 24 24"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path d="M3.5 7.8 12 12l8.5-4.2M12 12v9M8 5l9 4.2"/></svg><span>تحویل کالا</span></button>
        <button class="nav-link" data-view="statements"><svg viewBox="0 0 24 24"><path d="M6 3.5h9l4 4V21H6zM15 3.5V8h4M9 12h7M9 16h7"/></svg><span>دفتر حساب</span></button>
        <button class="nav-link" data-view="reports"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg><span>گزارش‌ها</span></button>
      </nav>

      <div class="nav-caption nav-caption-gap">تنظیمات</div>
      <nav class="nav-list">
        <button class="nav-link" data-view="settings"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="m19.4 15 .1.1 1.2 1-.1 1.8-1.6 1.1-1.5-.7-.1-.1-1.3.7-.4 1.7h-2l-.8-1.5-1.5-.2-1.3 1-1.7-.8-.1-1.8 1.2-1.1-.1-1.5-1.5-.8v-2l1.6-.7.5-1.4-.8-1.6 1.3-1.4 1.7.5 1.2-.7.4-1.7h2l.8 1.5 1.5.2 1.3-1 1.7.8.1 1.8-1.2 1.1.1 1.5 1.5.8v2l-1.6.7-.5 1.4Z"/></svg><span>تنظیمات سامانه</span></button>
      </nav>

      <div class="sidebar-spacer"></div>
      <div class="sidebar-help">
        <div class="help-orbit"><svg viewBox="0 0 24 24"><path d="M12 17v.1M9.6 9a2.5 2.5 0 1 1 4.4 1.6c-.9 1-2 1.1-2 2.7M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z"/></svg></div>
        <strong>به راهنمایی نیاز دارید؟</strong>
        <span>مرکز راهنما و آموزش سامانه</span>
        <button type="button" class="help-action" data-toast="بخش راهنما در نسخه عملیاتی فعال می‌شود.">مشاهده راهنما <span>←</span></button>
      </div>
      <div class="sidebar-footer"><span class="status-pulse"></span><span>نسخه نمایشی</span><span class="version">v0.1.0</span></div>
    </aside>

    <div class="mobile-scrim" id="mobileScrim"></div>

    <main class="main-area">
      <header class="topbar">
        <div class="topbar-start">
          <button class="icon-button menu-toggle" id="menuToggle" aria-label="باز کردن منو"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
          <div class="breadcrumb"><span>فضای کاری</span><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg><strong id="breadcrumbCurrent">نمای کلی</strong></div>
        </div>
        <div class="topbar-end">
          <label class="global-search"><svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><input id="globalSearch" type="search" placeholder="جست‌وجوی مشتری، سند..." aria-label="جست‌وجوی کلی" /><kbd>⌘ K</kbd></label>
          <button class="icon-button theme-toggle" id="themeToggle" aria-label="تغییر پوسته"><svg class="sun-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
          <button class="icon-button notification-button" aria-label="اعلان‌ها" data-toast="در حال حاضر اعلان جدیدی ندارید."><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg><i></i></button>
          <div class="topbar-divider"></div>
          <button class="user-menu" data-toast="حساب مدیر در نسخه عملیاتی متصل می‌شود."><span class="user-avatar">م</span><span class="user-details"><strong>مدیر سامانه</strong><small>دسترسی کامل</small></span><svg viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg></button>
        </div>
      </header>

      <div class="demo-notice"><span class="notice-icon"><svg viewBox="0 0 24 24"><path d="M12 8v4m0 4h.01M10.3 3.8 2.9 17a2 2 0 0 0 1.8 3h14.6a2 2 0 0 0 1.8-3L13.7 3.8a2 2 0 0 0-3.4 0Z"/></svg></span><span><strong>محیط نمایشی</strong> — همه اعداد و سوابق این صفحه نمونه هستند و به حساب یا بازار واقعی متصل نیستند.</span><button type="button" aria-label="بستن هشدار" id="dismissNotice"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>

      <div class="content-wrap">
        <!-- DASHBOARD -->
        <section class="view-section active" data-section="dashboard">
          <div class="page-heading">
            <div><div class="eyebrow"><span class="eyebrow-line"></span>شنبه، ۳۰ آبان ۱۴۰۵</div><h1>نمای کلی کسب‌وکار</h1><p>تصویری روشن از وضعیت معاملات و حساب مشتریان شما.</p></div>
            <div class="heading-actions"><button class="button button-secondary" data-toast="فیلتر تاریخ در نسخه عملیاتی متصل می‌شود."><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>۳۰ روز اخیر <svg class="button-chevron" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"/></svg></button><button class="button button-primary" id="openTradeModal"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>ثبت معامله جدید</button></div>
          </div>

          <div class="stats-grid">
            <article class="stat-card stat-highlight"><div class="stat-top"><span class="stat-label">مجموع مشتریان</span><span class="stat-icon violet"><svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM16 3.2a4 4 0 0 1 0 7.6M17 14.7a4 4 0 0 1 4 4V20"/></svg></span></div><div class="stat-value">۱۲۸ <small>نفر</small></div><div class="stat-bottom"><span class="trend positive"><svg viewBox="0 0 24 24"><path d="m5 15 6-6 4 4 5-6M14 7h6v6"/></svg> ۱۲.۸٪</span><span>نسبت به ماه قبل</span></div><div class="stat-spark spark-violet"><svg viewBox="0 0 120 34"><path d="M1 27 12 24 24 25 35 17 47 20 58 12 70 18 82 9 94 12 106 4 119 7"/></svg></div></article>
            <article class="stat-card"><div class="stat-top"><span class="stat-label">معاملات امروز</span><span class="stat-icon blue"><svg viewBox="0 0 24 24"><path d="M4 7h15M15 3l4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg></span></div><div class="stat-value">۴۲ <small>سند</small></div><div class="stat-bottom"><span class="trend positive"><svg viewBox="0 0 24 24"><path d="m5 15 6-6 4 4 5-6M14 7h6v6"/></svg> ۸.۴٪</span><span>نسبت به دیروز</span></div><div class="stat-spark spark-blue"><svg viewBox="0 0 120 34"><path d="M1 27 12 22 24 26 35 14 47 17 58 10 70 15 82 8 94 13 106 4 119 6"/></svg></div></article>
            <article class="stat-card"><div class="stat-top"><span class="stat-label">حجم معاملات امروز</span><span class="stat-icon amber"><svg viewBox="0 0 24 24"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4.5 7.8 7.5 4.4 7.5-4.4M12 12.2V21"/></svg></span></div><div class="stat-value">۲.۸۱ <small>کیلوگرم</small></div><div class="stat-bottom"><span class="trend positive"><svg viewBox="0 0 24 24"><path d="m5 15 6-6 4 4 5-6M14 7h6v6"/></svg> ۵.۲٪</span><span>نسبت به دیروز</span></div><div class="stat-spark spark-amber"><svg viewBox="0 0 120 34"><path d="M1 25 12 19 24 23 35 20 47 12 58 15 70 8 82 13 94 5 106 8 119 3"/></svg></div></article>
            <article class="stat-card"><div class="stat-top"><span class="stat-label">مانده بدهکاری مشتریان</span><span class="stat-icon rose"><svg viewBox="0 0 24 24"><path d="M12 3v18M17 7.5c0-1.7-2.2-3-5-3s-5 1.3-5 3 1.6 2.6 5 3 5 1.3 5 3-2.2 3-5 3-5-1.3-5-3"/></svg></span></div><div class="stat-value">۴.۳۲ <small>میلیارد واحد پول نمونه</small></div><div class="stat-bottom"><span class="trend negative"><svg viewBox="0 0 24 24"><path d="m5 9 6 6 4-4 5 6M14 17h6v-6"/></svg> ۲.۱٪</span><span>نسبت به ماه قبل</span></div><div class="stat-spark spark-rose"><svg viewBox="0 0 120 34"><path d="M1 6 12 12 24 9 35 18 47 13 58 22 70 17 82 24 94 20 106 28 119 25"/></svg></div></article>
          </div>

          <div class="dashboard-grid">
            <article class="panel performance-panel">
              <div class="panel-heading"><div><h2>روند فعالیت معاملات</h2><p>حجم معاملات ثبت‌شده در بازه انتخابی</p></div><div class="chart-legend"><span><i></i>خرید مشتری</span><span><i></i>فروش مشتری</span></div></div>
              <div class="chart-summary"><strong>۱۸.۶۴ <small>کیلوگرم</small></strong><span class="trend positive">+ ۹.۲٪ <small>در این دوره</small></span></div>
              <div class="chart-wrap">
                <div class="chart-y-labels"><span>۸ kg</span><span>۶ kg</span><span>۴ kg</span><span>۲ kg</span><span>۰</span></div>
                <svg class="activity-chart" viewBox="0 0 700 220" preserveAspectRatio="none" role="img" aria-label="نمودار نمایشی حجم معاملات"><defs><linearGradient id="goldFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#c7a56a" stop-opacity=".23"/><stop offset="1" stop-color="#c7a56a" stop-opacity="0"/></linearGradient><linearGradient id="blueFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#7b92b7" stop-opacity=".15"/><stop offset="1" stop-color="#7b92b7" stop-opacity="0"/></linearGradient></defs><g class="chart-grid"><path d="M0 12H700M0 59H700M0 106H700M0 153H700M0 200H700"/></g><path d="M0 150 C35 144 52 135 82 142 S130 120 164 126 S213 100 246 111 S293 94 328 105 S378 70 410 82 S458 62 492 80 S541 42 573 61 S622 40 656 47 S682 28 700 34 L700 200H0Z" fill="url(#goldFill)"/><path d="M0 150 C35 144 52 135 82 142 S130 120 164 126 S213 100 246 111 S293 94 328 105 S378 70 410 82 S458 62 492 80 S541 42 573 61 S622 40 656 47 S682 28 700 34" fill="none" stroke="#bb975c" stroke-width="3" stroke-linecap="round"/><path d="M0 178 C35 168 55 181 82 170 S130 153 164 165 S213 142 246 154 S293 125 328 144 S378 119 410 130 S458 114 492 123 S541 96 573 110 S622 91 656 101 S682 83 700 92 L700 200H0Z" fill="url(#blueFill)"/><path d="M0 178 C35 168 55 181 82 170 S130 153 164 165 S213 142 246 154 S293 125 328 144 S378 119 410 130 S458 114 492 123 S541 96 573 110 S622 91 656 101 S682 83 700 92" fill="none" stroke="#7b92b7" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="5 5"/></svg>
                <div class="chart-x-labels"><span>۱ آبان</span><span>۵ آبان</span><span>۱۰ آبان</span><span>۱۵ آبان</span><span>۲۰ آبان</span><span>۳۰ آبان</span></div>
              </div>
              <div class="chart-footnote"><span class="footnote-dot"></span> نمودار صرفاً برای نمایش رابط کاربری است و از داده واقعی استخراج نشده است.</div>
            </article>

            <article class="panel balance-panel">
              <div class="panel-heading"><div><h2>ترکیب موجودی مشتریان</h2><p>تفکیک وزنی بر اساس نوع فلز</p></div><button class="more-button" aria-label="گزینه‌های بیشتر" data-toast="گزینه‌های گزارش در نسخه عملیاتی فعال می‌شوند.">•••</button></div>
              <div class="donut-area"><div class="donut-chart"><div class="donut-hole"><strong>۱.۲۸</strong><span>تن مجموع</span></div></div><div class="donut-center-label"></div></div>
              <div class="metal-legend"><div><span class="legend-name"><i class="dot-gold"></i>طلا</span><strong>۴۸.۶٪ <small>۶۲۱ کیلو</small></strong></div><div><span class="legend-name"><i class="dot-silver"></i>نقره</span><strong>۳۴.۲٪ <small>۴۳۸ کیلو</small></strong></div><div><span class="legend-name"><i class="dot-platinum"></i>پلاتین</span><strong>۱۷.۲٪ <small>۲۲۱ کیلو</small></strong></div></div>
            </article>
          </div>

          <div class="dashboard-grid lower-grid">
            <article class="panel table-panel">
              <div class="panel-heading"><div><h2>آخرین معاملات</h2><p>آخرین اسناد ثبت‌شده در سامانه</p></div><button class="text-link" data-nav="trades">مشاهده همه <span>←</span></button></div>
              <div class="table-scroll"><table class="data-table" id="recentTradesTable"><thead><tr><th>شناسه سند</th><th>مشتری</th><th>نوع معامله</th><th>محصول</th><th>وزن</th><th>مبلغ کل</th><th>وضعیت</th></tr></thead><tbody>
                <tr><td><span class="mono">TR-1048</span></td><td><div class="table-person"><span class="person-avatar avatar-sand">م</span><strong>محمدرضا احمدی</strong></div></td><td><span class="trade-type buy">خرید مشتری</span></td><td>طلای ۱۸ عیار</td><td class="numeric">۲۵۰ گرم</td><td class="numeric">۱,۸۷۵,۰۰۰,۰۰۰</td><td><span class="status-pill success">قطعی</span></td></tr>
                <tr><td><span class="mono">TR-1047</span></td><td><div class="table-person"><span class="person-avatar avatar-blue">س</span><strong>سارا محمدی</strong></div></td><td><span class="trade-type sell">فروش مشتری</span></td><td>نقره خالص</td><td class="numeric">۱.۲ کیلو</td><td class="numeric">۹۸,۴۰۰,۰۰۰</td><td><span class="status-pill success">قطعی</span></td></tr>
                <tr><td><span class="mono">TR-1046</span></td><td><div class="table-person"><span class="person-avatar avatar-green">ع</span><strong>علی رضایی</strong></div></td><td><span class="trade-type buy">خرید مشتری</span></td><td>طلای ۲۴ عیار</td><td class="numeric">۱۰۰ گرم</td><td class="numeric">۸۷۰,۰۰۰,۰۰۰</td><td><span class="status-pill pending">در انتظار</span></td></tr>
                <tr><td><span class="mono">TR-1045</span></td><td><div class="table-person"><span class="person-avatar avatar-lilac">ن</span><strong>نگار کریمی</strong></div></td><td><span class="trade-type sell">فروش مشتری</span></td><td>طلای ۱۸ عیار</td><td class="numeric">۷۵ گرم</td><td class="numeric">۵۶۲,۵۰۰,۰۰۰</td><td><span class="status-pill success">قطعی</span></td></tr>
              </tbody></table></div>
              <div class="table-footer"><span>نمایش ۴ مورد از ۴۲ معامله امروز</span><button class="pagination-next" data-nav="trades">مشاهده سوابق <span>←</span></button></div>
            </article>

            <article class="panel debt-panel">
              <div class="panel-heading"><div><h2>حساب‌های نیازمند پیگیری</h2><p>بیشترین مانده بدهکاری نمونه</p></div><span class="count-badge">۳</span></div>
              <div class="debt-list">
                <div class="debt-item"><span class="person-avatar avatar-sand">م</span><div class="debt-main"><strong>محمدرضا احمدی</strong><small>آخرین فعالیت: امروز</small></div><div class="debt-amount"><strong>۸۴۵,۰۰۰,۰۰۰</strong><small>واحد پول نمونه</small></div></div>
                <div class="debt-item"><span class="person-avatar avatar-green">ع</span><div class="debt-main"><strong>علی رضایی</strong><small>آخرین فعالیت: دیروز</small></div><div class="debt-amount"><strong>۶۲۴,۵۰۰,۰۰۰</strong><small>واحد پول نمونه</small></div></div>
                <div class="debt-item"><span class="person-avatar avatar-lilac">ن</span><div class="debt-main"><strong>نگار کریمی</strong><small>آخرین فعالیت: ۳ روز پیش</small></div><div class="debt-amount"><strong>۳۱۸,۲۰۰,۰۰۰</strong><small>واحد پول نمونه</small></div></div>
              </div>
              <button class="panel-wide-link" data-nav="customers">مشاهده همه حساب‌ها <span>←</span></button>
            </article>
          </div>

          <div class="market-strip"><div class="market-title"><span class="market-mark">✦</span><div><strong>تابلوی قیمت فلزات</strong><small>مقادیر نمایشی، بدون اتصال به بازار</small></div></div><div class="market-items"><div class="market-item"><span class="metal-symbol gold">Au</span><div><strong>طلای ۱۸ عیار</strong><small>هر گرم</small></div><b>۷,۵۰۰,۰۰۰ <small>واحد پول نمونه</small></b></div><div class="market-item"><span class="metal-symbol silver">Ag</span><div><strong>نقره خالص</strong><small>هر گرم</small></div><b>۸۲,۰۰۰ <small>واحد پول نمونه</small></b></div><div class="market-item"><span class="metal-symbol platinum">Pt</span><div><strong>پلاتین</strong><small>هر گرم</small></div><b>۳,۸۵۰,۰۰۰ <small>واحد پول نمونه</small></b></div></div><button class="market-arrow" data-nav="prices" aria-label="مشاهده قیمت‌ها">←</button></div>
        </section>

        <!-- CUSTOMERS -->
        <section class="view-section" data-section="customers">
