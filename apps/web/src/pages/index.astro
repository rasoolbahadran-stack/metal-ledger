---
import Layout from '../layouts.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const appUrl = `${base}/app/`;
const repoUrl = 'https://github.com/rasoolbahadran-stack/metal-ledger';
---

<Layout
  title="فلزنگار | سامانه مدیریت معاملات فلزات گران‌بها"
  description="فلزنگار یک سامانه فارسی‌زبان برای مدیریت معاملات فلزات، دفتر وزنی مشتریان و دفتر حساب مالی است — با تفکیک کامل دفتر وزنی و مالی، اسناد قابل حسابرسی و رابط کاربری راست‌چین."
  ogType="website"
>
  <a class="skip-link" href="#mainContent">پرش به محتوای اصلی</a>

  <div class="landing">
    <!-- ================= ناوبری ================= -->
    <nav class="site-nav" aria-label="ناوبری سایت">
      <div class="site-nav-inner">
        <a class="nav-brand" href={base + '/'} aria-label="فلزنگار — صفحه اصلی">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40"><path d="M8 26.5 15.8 11l4.3 8.1 4.2-8.1L32 26.5H8Z"/><path d="M12 29.5h16" stroke-linecap="round"/><circle cx="20" cy="8" r="1.7" fill="currentColor" stroke="none"/></svg>
          </span>
          <span class="nav-brand-text"><strong>فلزنگار</strong><span>METAL LEDGER</span></span>
        </a>
        <div class="nav-links">
          <a href="#features">قابلیت‌ها</a>
          <a href="#ledger">دفتر وزنی و مالی</a>
          <a href="#customers">مشتریان</a>
          <a href="#reports">گزارش‌ها</a>
          <a href="#faq">پرسش‌های متداول</a>
        </div>
        <div class="nav-cta">
          <a class="button button-ghost" href={repoUrl} target="_blank" rel="noopener noreferrer">مخزن گیت‌هاب</a>
          <a class="button button-primary" href={appUrl}>مشاهده نسخه نمایشی</a>
        </div>
        <button class="menu-btn" aria-label="باز کردن منو" aria-expanded="false">
          <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
      <div class="mobile-menu">
        <a href="#features">قابلیت‌ها</a>
        <a href="#ledger">دفتر وزنی و مالی</a>
        <a href="#customers">مشتریان</a>
        <a href="#reports">گزارش‌ها</a>
        <a href="#faq">پرسش‌های متداول</a>
        <a href={appUrl} style="color:var(--accent-strong);font-weight:700">مشاهده نسخه نمایشی ←</a>
      </div>
    </nav>

    <main id="mainContent">
      <!-- ================= Hero ================= -->
      <header class="hero">
        <div class="hero-bg" aria-hidden="true"></div>
        <div class="hero-inner">
          <span class="hero-eyebrow reveal"><span class="dot"></span>نسخه نمایشی عمومی منتشر شده است</span>
          <h1 class="reveal reveal-d1">
            حساب فلزات شما، دقیق و <span class="gold">قابل حسابرسی<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9 C40 3, 80 3, 118 7 S 170 9, 198 5" fill="none" stroke-width="3"/></svg></span> می‌ماند
          </h1>
          <p class="hero-sub reveal reveal-d2">
            فلزنگار سامانه‌ای فارسی‌زبان برای مدیریت معاملات فلزات گران‌بهاست؛ با تفکیک کامل دفتر وزنی و دفتر مالی، ثبت اسناد قابل پیگیری و دفتر حساب شفاف برای هر مشتری — همه‌چیز در یک رابط کاربری راست‌چین و سریع.
          </p>
          <div class="hero-actions reveal reveal-d3">
            <a class="button button-primary" href={appUrl}>
              <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="4.5" rx="1.5"/><rect x="13.5" y="11" width="7" height="9.5" rx="1.5"/><rect x="3.5" y="13" width="7" height="7.5" rx="1.5"/></svg>
              مشاهده نسخه نمایشی
            </a>
            <a class="button button-secondary" href="#features">
              آشنایی با قابلیت‌ها
              <svg viewBox="0 0 24 24"><path d="M19 12H5m6-6-6 6 6 6"/></svg>
            </a>
          </div>
          <p class="hero-note">بدون نیاز به ثبت‌نام · داده‌های پنل نمایشی کاملاً نمونه هستند</p>
        </div>

        <div class="hero-showcase reveal reveal-d2">
          <div class="window" role="img" aria-label="پیش‌نمایش محیط پنل مدیریت فلزنگار">
            <div class="window-bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span class="win-url">rasoolbahadran-stack.github.io/metal-ledger/app</span>
            </div>
            <div class="window-body" aria-hidden="true">
              <div class="mock-side">
                <div class="mock-brand"><i>م</i><div><strong>فلزنگار</strong><span>METAL LEDGER</span></div></div>
                <div class="mock-nav active"><svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="11" width="7" height="9.5" rx="1.5"/><rect x="3.5" y="13" width="7" height="7.5" rx="1.5"/></svg>نمای کلی</div>
                <div class="mock-nav"><svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20M9.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg>مشتریان</div>
                <div class="mock-nav"><svg viewBox="0 0 24 24"><path d="M4 7h15M15 3l4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg>معاملات</div>
                <div class="mock-nav"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 7h14M7 7l-4 7h8L7 7ZM17 7l-4 7h8l-4-7Z"/></svg>مانده وزنی</div>
                <div class="mock-nav"><svg viewBox="0 0 24 24"><path d="M6 3.5h9l4 4V21H6zM15 3.5V8h4M9 12h7M9 16h7"/></svg>دفتر حساب</div>
              </div>
              <div class="mock-main">
                <div class="mock-headline"><strong>نمای کلی کسب‌وکار</strong><span class="mock-btn">+ ثبت معامله</span></div>
                <div class="mock-stats">
                  <div class="mock-stat"><small>مجموع خرید مشتریان</small><b>۴٬۸۲۰٬۰۰۰٬۰۰۰</b><span class="up">▲ ۸.۲٪</span></div>
                  <div class="mock-stat"><small>موجودی وزنی</small><b>۱٬۲۸۰ <span style="font-size:11px">کیلوگرم</span></b><span class="up">▲ ۵.۱٪</span></div>
                  <div class="mock-stat"><small>مانده بدهکاری</small><b>۸۴۵٬۰۰۰٬۰۰۰</b><span class="up" style="color:var(--danger)">▼ ۲.۱٪</span></div>
                </div>
                <div class="mock-chart">
                  <svg viewBox="0 0 600 110" preserveAspectRatio="none">
                    <defs><linearGradient id="heroFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".28"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>
                    <path d="M0 84 C40 78 70 62 110 68 S 180 46 230 54 S 320 34 380 44 S 470 24 520 32 S 570 18 600 22 L600 110H0Z" fill="url(#heroFill)"/>
                    <path d="M0 84 C40 78 70 62 110 68 S 180 46 230 54 S 320 34 380 44 S 470 24 520 32 S 570 18 600 22" fill="none" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round"/>
                    <path d="M0 96 C50 92 90 80 140 84 S 220 66 280 72 S 380 56 440 62 S 520 48 600 52" fill="none" stroke="var(--info)" stroke-width="2" stroke-dasharray="5 4"/>
                  </svg>
                </div>
                <div class="mock-rows">
                  <div class="mock-row"><b>TR-1048 · محمدرضا احمدی</b><span>خرید · طلای ۱۸ عیار</span><span class="num">۲۵۰ گرم</span><span class="pill ok">قطعی</span></div>
                  <div class="mock-row"><b>TR-1047 · سارا محمدی</b><span>فروش · نقره خالص</span><span class="num">۱٬۲۰۰ گرم</span><span class="pill ok">قطعی</span></div>
                  <div class="mock-row"><b>TR-1046 · علی رضایی</b><span>خرید · طلای ۲۴ عیار</span><span class="num">۱۰۰ گرم</span><span class="pill wait">پیش‌نویس</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- ================= آمار اعتماد ================= -->
      <div class="trust-strip">
        <div class="trust-inner">
          <div class="trust-item"><b>۱۱</b><span>ماژول مدیریتی در پنل نمایشی</span></div>
          <div class="trust-item"><b>۱۰۰٪</b><span>رابط کاربری فارسی و راست‌چین</span></div>
          <div class="trust-item"><b>Decimal</b><span>محاسبات وزنی و مالی با دقت اعشاری</span></div>
          <div class="trust-item"><b>۰</b><span>داده واقعی در نسخه نمایشی — همه‌چیز نمونه</span></div>
        </div>
      </div>

      <!-- ================= قابلیت‌ها ================= -->
      <section class="section" id="features">
        <div class="section-inner">
          <div class="section-head-center">
            <span class="section-eyebrow reveal">قابلیت‌های اصلی</span>
            <h2 class="reveal reveal-d1">هر آنچه یک دفتر فلزات واقعی لازم دارد</h2>
            <p class="section-sub reveal reveal-d2">طراحی فلزنگار بر اساس گردش واقعی معاملات فلزات گران‌بها شکل گرفته است: سند، وزن، قیمت، تسویه و تحویل — هرکدام در جای درست خودشان.</p>
          </div>
          <div class="features-grid">
            <article class="feature-card reveal">
              <span class="feature-icon c1"><svg viewBox="0 0 24 24"><path d="M4 7h15M15 3l4 4-4 4M20 17H5m4-4-4 4 4 4"/></svg></span>
              <h3>ثبت خرید و فروش</h3>
              <p>ثبت سند با انتخاب مشتری، محصول، وزن و نرخ واحد؛ محاسبه خودکار مبلغ با گردکردن استاندارد و نمایش خلاصه سند قبل از قطعی‌شدن.</p>
            </article>
            <article class="feature-card reveal reveal-d1">
              <span class="feature-icon c4"><svg viewBox="0 0 24 24"><path d="M12 3v18M5 7h14M7 7l-4 7h8L7 7ZM17 7l-4 7h8l-4-7ZM8 21h8"/></svg></span>
              <h3>دفتر وزنی مستقل</h3>
              <p>مانده هر مشتری برای هر محصول جداگانه نگه‌داری می‌شود؛ خرید و فروش و تحویل فیزیکی با علامت مشخص روی مانده اثر می‌گذارند.</p>
            </article>
            <article class="feature-card reveal reveal-d2">
              <span class="feature-icon c2"><svg viewBox="0 0 24 24"><path d="M12 3v18M17 7.5c0-1.7-2.2-3-5-3s-5 1.3-5 3 1.6 2.6 5 3 5 1.3 5 3-2.2 3-5 3-5-1.3-5-3"/></svg></span>
              <h3>دفتر مالی با قرارداد مشخص</h3>
              <p>بدهکار مثبت، بستانکار منفی؛ مانده مالی مشتری همیشه شفاف است و مانده معکوس بی‌صدا صفر نمی‌شود.</p>
            </article>
            <article class="feature-card reveal">
              <span class="feature-icon c3"><svg viewBox="0 0 24 24"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path d="M3.5 7.8 12 12l8.5-4.2M12 12v9"/></svg></span>
              <h3>تحویل فیزیکی کالا</h3>
              <p>رسید تحویل با کنترل مانده وزنی در سمت سرور؛ طبق قواعد فعلی تحویل فقط دفتر وزنی را تغییر می‌دهد.</p>
            </article>
            <article class="feature-card reveal reveal-d1">
              <span class="feature-icon c5"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h17M8 15l3-4 3 2 5-7"/></svg></span>
              <h3>گزارش و تحلیل</h3>
              <p>گزارش معاملات با فیلتر بازه و محصول، خلاصه داشبورد و دفتر حساب قابل چاپ برای هر مشتری.</p>
            </article>
            <article class="feature-card reveal reveal-d2">
              <span class="feature-icon c6"><svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
              <h3>اسناد قابل حسابرسی</h3>
              <p>اسناد قطعی حذف یا ویرایش مستقیم نمی‌شوند؛ اصلاح با سند معکوس و ثبت علت در لاگ حسابرسی انجام می‌شود.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- ================= مدیریت معاملات ================= -->
      <section class="section alt" id="trades">
        <div class="section-inner">
          <div class="duo">
            <div class="duo-copy">
              <span class="section-eyebrow reveal">مدیریت معاملات</span>
              <h2 class="reveal reveal-d1">از سند پیش‌نویس تا سند قطعی، بدون ابهام</h2>
              <p class="section-sub reveal reveal-d2">هر معامله یک سند با شناسه پایدار است. وضعیت هر سند — پیش‌نویس، قطعی یا برگشت‌خورده — همیشه قابل مشاهده است و تاریخچه آن از بین نمی‌رود.</p>
              <ul class="duo-list reveal reveal-d2">
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>شناسه سند پایدار</b> — شماره سند پس از ثبت تغییر نمی‌کند و مرجع همه رویدادهای بعدی است.</span></li>
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>Snapshot قیمت و ارز</b> — نرخ و ارز هنگام ثبت در سند ذخیره می‌شود؛ تغییر قیمت‌های بعدی سند گذشته را تغییر نمی‌دهد.</span></li>
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>برگشت استاندارد</b> — اصلاح اسناد قطعی فقط با سند معکوس و ثبت علت انجام می‌شود.</span></li>
              </ul>
            </div>
            <div class="duo-visual reveal reveal-d1">
              <div class="visual-card">
                <div class="vc-head"><strong>جدول معاملات</strong><span class="demo-chip">داده نمایشی</span></div>
                <table class="vc-table">
                  <thead><tr><th>سند</th><th>مشتری</th><th>وزن</th><th>مبلغ کل</th><th>وضعیت</th></tr></thead>
                  <tbody>
                    <tr><td class="mono">TR-1048</td><td>محمدرضا احمدی</td><td class="num">۲۵۰ گرم</td><td class="num">۱٬۸۷۵٬۰۰۰٬۰۰۰</td><td><span class="status-pill success">قطعی</span></td></tr>
                    <tr><td class="mono">TR-1047</td><td>سارا محمدی</td><td class="num">۱٬۲۰۰ گرم</td><td class="num">۹۸٬۴۰۰٬۰۰۰</td><td><span class="status-pill success">قطعی</span></td></tr>
                    <tr><td class="mono">TR-1046</td><td>علی رضایی</td><td class="num">۱۰۰ گرم</td><td class="num">۸۷۰٬۰۰۰٬۰۰۰</td><td><span class="status-pill pending">پیش‌نویس</span></td></tr>
                    <tr><td class="mono">TR-1044</td><td>امیرحسین زمانی</td><td class="num">۴۰۰ گرم</td><td class="num">۱٬۵۴۰٬۰۰۰٬۰۰۰</td><td><span class="status-pill danger">برگشت‌خورده</span></td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= دفتر وزنی و مالی ================= -->
      <section class="section" id="ledger">
        <div class="section-inner">
          <div class="duo">
            <div class="duo-copy">
              <span class="section-eyebrow reveal">تفکیک دو دفتر</span>
              <h2 class="reveal reveal-d1">دفتر وزنی و دفتر مالی، هرکدام به‌جای خودشان</h2>
              <p class="section-sub reveal reveal-d2">اشتباه گرفتن وزن فلز با پول، ریشه بسیاری از خطاهای حسابداری است. فلزنگار این دو را از نظر بصری و معنایی کاملاً جدا نگه می‌دارد و هر رویداد را فقط روی دفتر درست خودش می‌نویسد.</p>
              <ul class="duo-list reveal reveal-d2">
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>مانده وزنی</b> برای هر مشتری و هر محصول، در واحد پایه محصول با دقت قابل تنظیم.</span></li>
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>مانده مالی</b> با قرارداد بدهکار مثبت و بستانکار منفی؛ مانده معکوس پنهان نمی‌شود.</span></li>
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>تحویل فیزیکی</b> به‌صورت پیش‌فرض فقط دفتر وزنی را کم می‌کند؛ سیاست مالی تحویل نیازمند تصمیم کسب‌وکار شماست.</span></li>
              </ul>
            </div>
            <div class="duo-visual reveal reveal-d1">
              <div class="ledger-split">
                <div class="ledger-box w">
                  <h4><svg viewBox="0 0 24 24"><path d="M12 3v18M5 7h14M7 7l-4 7h8L7 7ZM17 7l-4 7h8l-4-7Z"/></svg>دفتر وزنی — طلا (نمایشی)</h4>
                  <div class="lb-row"><span>جمع خرید</span><b>۴۰۰.۰۰۰ گرم</b></div>
                  <div class="lb-row"><span>جمع فروش</span><b>۱۰۰.۰۰۰ گرم</b></div>
                  <div class="lb-row"><span>تحویل‌شده</span><b>۵۰.۰۰۰ گرم</b></div>
                  <div class="lb-row"><span>مانده</span><b style="color:var(--success)">+۲۵۰.۰۰۰ گرم</b></div>
                </div>
                <div class="ledger-box m">
                  <h4><svg viewBox="0 0 24 24"><path d="M12 3v18M17 7.5c0-1.7-2.2-3-5-3s-5 1.3-5 3 1.6 2.6 5 3 5 1.3 5 3-2.2 3-5 3-5-1.3-5-3"/></svg>دفتر مالی — همان مشتری (نمایشی)</h4>
                  <div class="lb-row"><span>بدهکار (خرید)</span><b>۱٬۸۷۵٬۰۰۰٬۰۰۰</b></div>
                  <div class="lb-row"><span>بستانکار (دریافت)</span><b>۳۰۰٬۰۰۰٬۰۰۰</b></div>
                  <div class="lb-row"><span>مانده</span><b style="color:var(--danger)">۱٬۵۷۵٬۰۰۰٬۰۰۰ بدهکار</b></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= مشتریان ================= -->
      <section class="section alt" id="customers">
        <div class="section-inner">
          <div class="duo">
            <div class="duo-copy">
              <span class="section-eyebrow reveal">مدیریت مشتریان</span>
              <h2 class="reveal reveal-d1">پروفایل هر مشتری، یک دفتر کامل</h2>
              <p class="section-sub reveal reveal-d2">با باز کردن هر مشتری، خلاصه حساب وزنی و مالی، سابقه معاملات و سابقه پرداخت و دریافت او در یک نگاه مشخص است — و با یک کلیک می‌توانید مستقیماً برایش معامله ثبت کنید.</p>
              <ul class="duo-list reveal reveal-d2">
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>جست‌وجو و فیلتر سریع</b> بر اساس نام، کد مشتری و وضعیت حساب.</span></li>
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>خلاصه حساب زنده</b> — مانده وزنی و مالی مستقیماً از اسناد محاسبه می‌شود.</span></li>
                <li><svg viewBox="0 0 24 24"><path d="m5 12 5 5 9-10"/></svg><span><b>دسترسی سریع به ثبت معامله</b> با مشتری از پیش انتخاب‌شده.</span></li>
